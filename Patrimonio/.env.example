POSTGRES_USER=patr
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=patrimony
DATABASE_URL=postgresql://patr:replace-with-a-strong-db-password@db:5432/patrimony
APP_ENV=production
RUN_MIGRATIONS=true
APP_AUTH_ENABLED=true
APP_BOOTSTRAP_TOKEN=replace-with-a-one-time-production-bootstrap-token
APP_PUBLIC_URL=https://patrimonio.example.com
APP_COOKIE_SECURE=true
APP_COOKIE_SAMESITE=strict
APP_LOGIN_RATE_LIMIT_ATTEMPTS=5
APP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
APP_RESTORE_ENABLED=false
APP_PASSWORD_RESET_TTL_SECONDS=1800
APP_PASSWORD_RESET_DELIVERY=smtp
APP_INVITATION_DELIVERY=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=billsbot.admin@gmail.com
SMTP_PASSWORD=replace-with-a-google-app-password
SMTP_FROM=billsbot.admin@gmail.com
PATRIMONIO_USERNAME=admin
PATRIMONIO_PASSWORD=replace-with-a-strong-login-password
PATRIMONIO_SESSION_SECRET=replace-with-a-long-random-session-secret
PATRIMONIO_SESSION_TTL_SECONDS=43200
